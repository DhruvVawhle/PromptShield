# ==============================================================================
# PromptShield Environment Configuration Template
# Copy to .env.local for local development. Never commit sensitive keys to git.
# ==============================================================================

# --- AI Provider Configuration (Groq / OmniRoute) ---
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Backward compatibility aliases for Groq
OMNIROUTE_BASE_URL=https://api.groq.com/openai/v1
OMNIROUTE_API_KEY=gsk_your_groq_api_key_here
OMNIROUTE_MODEL=qwen/qwen3.8-27b

# --- Rate Limiting (Upstash Redis) ---
# Strictly mandatory in production. In-memory fallback is never permitted in production under any circumstance.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Edge & Proxy Infrastructure Verification
# Set to true ONLY when deployment is verified behind Cloudflare Edge
TRUST_CLOUDFLARE=false
# Set to true ONLY when deployment is behind a verified trusted reverse proxy (e.g. AWS ALB, NGINX)
TRUST_PROXY=false
# Number of reverse proxy hops to ignore before extracting client IP (default: 1)
TRUST_PROXY_HOPS=1

# --- Cryptographic Audit Trail ---
# 256-bit secret key used to HMAC-sign audit records and chain hashes.
AUDIT_SIGNING_KEY=your-32-byte-cryptographic-signing-key-here

# --- Firebase Client Configuration (Public) ---
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef0123456789
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Firebase Admin SDK Configuration (Server-Side Only) ---
# Used for verified ID token inspection, RBAC roles, and Cloud Firestore mutations.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Multi-line private key formatted with escaped newlines (\n)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# --- Google Gemini AI Provider Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
